# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# Flutter and Dart (frontend/.gitignore has the full Flutter rules)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Android signing
*.jks
*.keystore
key.properties
local.properties

# Editor settings
.vscode/
.idea/

# Logs
*.log

# Flutter run configuration (copy config/dev.example.json to config/dev.json)
frontend/config/*.json
!frontend/config/*.example.json

# Datasets, caches, logs and trained models stay local (requirements §23).
# Only the job title and skill catalogue is shared: it is built from public data and has no personal data.
ai_backend/data/*
!ai_backend/data/catalog/
ai_backend/models/

# Design reference downloads (kept outside Git)
/*.zip
/*.dmg
/Dial/
/design-handoff/

# Methodology sources kept locally (only the PNG diagrams are shared)
Methodology/drawio/
Methodology/*.zip
