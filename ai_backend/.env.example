# Copy to .env and fill in real values. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: safe for frontend, protected by RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: BACKEND ONLY, bypasses RLS. Never share or commit.
SUPABASE_SECRET_KEY=

# DeepSeek LLM — backend only. Never share or commit.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_MONTHLY_BUDGET_USD=5

# Local testing mode (no login, results in data/logbook). Keep false when deployed.
TESTING_MODE=false
