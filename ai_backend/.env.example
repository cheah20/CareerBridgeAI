# Copy to .env and fill in real values. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: safe for frontend, protected by RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: BACKEND ONLY, bypasses RLS. Never share or commit.
SUPABASE_SECRET_KEY=

# DeepSeek LLM — backend only. Never share or commit.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Monthly AI usage limit for the whole system. Set your own; 0 pauses AI tips.
LLM_MONTHLY_BUDGET_USD=0
# AI requests one user can make per day (cached answers do not count)
LLM_DAILY_REQUESTS_PER_USER=30

# Local testing mode (no login, results in data/logbook). Keep false when deployed.
TESTING_MODE=false
